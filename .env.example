# ── REQUIRED ──────────────────────────────────────────────────────
# MySQL connection string — app will crash on startup if missing
DATABASE_URL=mysql://root:1@localhost:3306/vocabulary_db

# Secret key for signing JWT session cookies — minimum 32 characters
JWT_SECRET=change_me_minimum_32_characters_long_random_string

# ── SERVER (optional) ─────────────────────────────────────────────
# Port the HTTP server listens on (default: 3000)
PORT=3000
# Host binding (default: 0.0.0.0)
HOST=0.0.0.0

# ── CORS (optional) ───────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://yourdomain.com

# ── OAUTH (optional — needed for OAuth login flow) ─────────────────
OAUTH_SERVER_URL=
# Admin user identifier for notification routing
OWNER_OPEN_ID=

# ── AI / MEDIA (optional — needed for TTS, voice, AI features) ────
# OpenAI API key for text-to-speech
OPENAI_API_KEY=
# Internal forge service for voice transcription and AI helpers
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ── FRONTEND ──────────────────────────────────────────────────────
# App identifier used in frontend feature flags
VITE_APP_ID=vocabulary-app
# Browser tab title
VITE_APP_TITLE=Vocabulary App
# Forge API for client-side map and media features (optional)
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
